# All variables here are public Config values. Never put secrets in VITE_*.
# Verified WhatsApp number: country code + DDD + number, digits only.
# Empty = use the confirmed Instagram profile for scheduling.
VITE_WHATSAPP_NUMBER=
# Confirmed production origin, e.g. https://your-domain.com.br (no invented domain).
# Empty = noindex, no canonical/sitemap. Set only for the production build.
VITE_SITE_URL=
